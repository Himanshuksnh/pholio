# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# Only variables prefixed with `VITE_` are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Public origin of the deployed site. Used for canonical URLs + Open Graph tags.
VITE_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# CONTACT FORM INTEGRATION POINT
# ---------------------------------------------------------------------------
# The contact form is a progressive enhancement: it works with no backend at all
# (it falls back to a pre-filled `mailto:` handoff) and posts to a real endpoint
# as soon as one is configured here.
#
# Set VITE_CONTACT_ENDPOINT to any HTTPS endpoint that accepts a JSON POST body
# with the keys: name, email, phone, projectType, budget, details, submittedAt.
#
# The endpoint must answer `2xx` on success. Any other status is surfaced to the
# visitor as an error — nothing is ever reported as delivered unless the
# endpoint actually confirmed it.
#
# Works out of the box with: Formspree, Basin, Web3Forms, a Cloudflare Worker,
# a Vercel/Netlify function, or your own API route.
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
